													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												]
										] ifFalse: [
											ubicacionTiroDelantero = ubicacionLanzaArquero 
												ifTrue: [
													fuerzaDelantero > fuerzaArquero 
														ifTrue: [
															self gol: ubicacionTiroDelantero  
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														] ifFalse: [
															self noGol: ubicacionLanzaArquero 
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														].
												] ifFalse: [
													self gol: ubicacionTiroDelantero
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												]
										].
								] ifFalse: [
									ubicacionTiroDelantero = ubicacionLanzaArquero 
										ifTrue: [
											fuerzaDelantero > fuerzaArquero 
												ifTrue: [
													self gol: ubicacionTiroDelantero  
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												] ifFalse: [
													self noGol: ubicacionLanzaArquero 
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												].
										] ifFalse: [
											self gol: ubicacionTiroDelantero
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										]
								].
						].
					arquero tipo = #DecideAntes
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionTiroDelantero x ~= 1
								ifTrue: [
									ubicacionTiroDelantero y ~= 1
										ifTrue: [
											(ubicacionTiroDelantero x @1) = ubicacionLanzaArquero 
												ifTrue: [
													fuerzaDelantero > fuerzaArquero 
														ifTrue: [
															self gol: (ubicacionTiroDelantero x @1) 
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														] ifFalse: [
															self noGol: ubicacionLanzaArquero 
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														].
												] ifFalse: [
													self gol: (ubicacionTiroDelantero x @1) 
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												]
										] ifFalse: [
											self noGol: (ubicacionTiroDelantero x @3) 
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										].
								] ifFalse: [
									ubicacionTiroDelantero = ubicacionLanzaArquero 
										ifTrue: [
											fuerzaDelantero > fuerzaArquero 
												ifTrue: [
													self gol: ubicacionTiroDelantero  
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												] ifFalse: [
													self noGol: ubicacionLanzaArquero 
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												].
										] ifFalse: [
											self gol: ubicacionTiroDelantero
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										]
								].
						].
				]. 
			pelota tipo = #Jabulani 
				ifTrue: [ fuerzaDelantero := fuerzaDelantero * 1.20.
					arquero tipo = #SeAdelanta
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionTiroDelantero x ~= 1
								ifTrue: [
									ubicacionTiroDelantero y ~= 1
										ifTrue: [
											self gol: (ubicacionTiroDelantero x @1) 
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										] ifFalse: [
