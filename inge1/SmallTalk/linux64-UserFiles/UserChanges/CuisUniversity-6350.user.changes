!classDefinition: #Penales category: #Penales stamp: 'as 4/27/2025 12:41:27'!
Object subclass: #Penales
	instanceVariableNames: 'delantero arquero pelota puntajeDelantero puntajeArquero direccionResultante fuerzaResultanteTiro fuerzaResultanteAtajada'
