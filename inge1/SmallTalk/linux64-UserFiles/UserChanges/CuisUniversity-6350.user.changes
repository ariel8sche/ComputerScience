!methodRemoval: Vehicle #initializeWithType:engineType:andSurroundings: stamp: 'as 4/7/2025 11:35:48'!
initializeWithType: typeToTake engineType: anEngineType andSurroundings: surroundings

	state := #Off.
	type := typeToTake.
	engineType := anEngineType.
	where := surroundings.
	speed := 0 * kilometer / hour.
	altitude := 0 * meter!

!methodRemoval: Vehicle #altitudeAt: stamp: 'as 4/7/2025 11:35:59'!
altitudeAt: anAltitude

	^ altitude = anAltitude!

!methodRemoval: Vehicle #speedAt: stamp: 'as 4/7/2025 11:36:03'!
speedAt: aSpeed

	^ speed = aSpeed!

!methodRemoval: Vehicle #turnOff stamp: 'as 4/7/2025 11:36:10'!
turnOff

	state := #Off.
	speed := 0 * kilometer / hour!

!methodRemoval: Vehicle #turnOn stamp: 'as 4/7/2025 11:36:10'!
turnOn

	state := #On!

!methodRemoval: Vehicle #canNotAccelerateErrorMessage stamp: 'as 4/7/2025 11:36:13'!
canNotAccelerateErrorMessage

	type = #Helicopter ifTrue:[^'Can not fly when turned off'].
	type = #Motorcycle ifTrue:[^'Can not run when turned off'].!

