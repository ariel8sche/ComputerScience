arbitroPitaConPelota: unPelota delanteroRemataAlArcoConDireccion: ubicacionTiroDelantero arqueroSeLanzaEnDirección: ubicacionLanzaArquero.

	pelota := unPelota .
	
	(ubicacionTiroDelantero between: 0@0 and: 2@2) ifFalse: [^self error: Penales direccionTiroFueraDeRango ].
	
	(ubicacionLanzaArquero between: 0@0 and: 2@2) ifFalse: [^self error: Penales direccionArqueroFueraDeRango ].
	
	delantero tipo = #AColocar 
		ifTrue: [
			fuerzaDelantero := delantero fuerza * 0.5.
			pelota tipo = #Playera 
				ifTrue: [
					fuerzaDelantero := fuerzaDelantero * 0.80.
					arquero tipo = #SeAdelanta
						ifTrue: [
							self gol:ubicacionTiroDelantero 
							fuerzaResultanteArquero: fuerzaArquero 
							fuerzaResultanteDelantero: fuerzaDelantero .
						].
					arquero tipo = #DecideAntes
						ifTrue: [
							fuerzaArquero := arquero fuerza * 2.0.
