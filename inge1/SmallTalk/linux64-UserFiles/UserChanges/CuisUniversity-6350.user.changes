!Vehicle methodsFor: 'move' stamp: 'as 4/10/2025 16:16:20' prior: 50549342!
accelerate

	| acceleration |
	
	powerState accelerate.

	engineType = #ElectricEngine ifTrue: [ acceleration := (speed + (5 * kilometer / hour)) * 2 ].
	engineType = #GasolineEngine ifTrue: [ acceleration := 10 * kilometer / hour ].
	engineType = #JetFueledEngine ifTrue: [ acceleration := ((speed amount + 1) ^ 2) * kilometer / hour ].

	where = #city ifTrue: [ speed > (70 * kilometer / hour) ifTrue: [ speed := 70 * kilometer / hour ] ].
	where = #openRoad ifTrue: [ speed > (130 * kilometer / hour) ifTrue: [ speed := 130 * kilometer / hour ] ].
	where = #skies ifTrue: [ speed > (500 * kilometer / hour) ifTrue: [ speed := 500 * kilometer / hour ] ]! !
!Vehicle methodsFor: 'move' stamp: 'as 4/10/2025 16:16:54' prior: 50549727!
accelerate

	| acceleration |
	
	powerState accelerate.

	engineType = #ElectricEngine ifTrue: [ acceleration := (speed + (5 * kilometer / hour)) * 2 ].
	engineType = #GasolineEngine ifTrue: [ acceleration := 10 * kilometer / hour ].
	engineType = #JetFueledEngine ifTrue: [ acceleration := ((speed amount + 1) ^ 2) * kilometer / hour ].
		
	where = #city ifTrue: [ speed > (70 * kilometer / hour) ifTrue: [ speed := 70 * kilometer / hour ] ].
	where = #openRoad ifTrue: [ speed > (130 * kilometer / hour) ifTrue: [ speed := 130 * kilometer / hour ] ].
	where = #skies ifTrue: [ speed > (500 * kilometer / hour) ifTrue: [ speed := 500 * kilometer / hour ] ]! !
!Helicopter methodsFor: 'move' stamp: 'as 4/10/2025 16:18:14'!
accelerateWhenMotorStateOn

	|acceleration|
	
	speed := speed + acceleration.
	altitude := altitude + (5 * meter).
! !
!Helicopter methodsFor: 'move' stamp: 'as 4/10/2025 16:18:33' prior: 50549773!
accelerateWhenMotorStateOn

	|acceleration|
	
	acceleration  := 0.
	
	speed := speed + acceleration.
	altitude := altitude + (5 * meter).
! !
!Motorcycle methodsFor: 'move' stamp: 'as 4/10/2025 16:19:16'!
accelerateWhenMotorStateOn

	| acceleration |
	
	acceleration  :=  0.
	
	speed := speed + acceleration.! !
