test01Y02v2CustomerActionShouldNotTakeMoreThanSpecificTime: aCustomerBook customerBookAction: anAction clientToPerformAction: aClient timeToEvaluate: aTime   

	| millisecondsBeforeRunning millisecondsAfterRunning |
	
	millisecondsBeforeRunning := Time millisecondClockValue * millisecond.
	aCustomerBook action: aClient.
	millisecondsAfterRunning := Time millisecondClockValue * millisecond.
	
	self assert: (millisecondsAfterRunning-millisecondsBeforeRunning) < (aTime * millisecond)
	
