!methodRemoval: Penales #esGol:fuerzaResultanteArquero:fuerzaResultanteDelantero: stamp: 'as 4/27/2025 12:42:03'!
esGol: ubicacionTiroGol fuerzaResultanteArquero: fuerzaFinalArquero fuerzaResultanteDelantero: fuerzaFinalDelantero  

	puntajeDelantero :=  1. 
	direccionResultante := ubicacionTiroGol.
	fuerzaResultanteAtajada := fuerzaFinalArquero .
	fuerzaResultanteTiro := fuerzaFinalDelantero .!

!methodRemoval: Penales #noEsGol:fuerzaResultanteArquero:fuerzaResultanteDelantero: stamp: 'as 4/27/2025 12:42:04'!
noEsGol: ubicacionDeLaAtajada fuerzaResultanteArquero: fuerzaFinalDelArquero fuerzaResultanteDelantero: fuerzaFinalDelDelantero  

	puntajeArquero :=  1.
	direccionResultante := ubicacionDeLaAtajada .
	fuerzaResultanteAtajada := fuerzaFinalDelArquero.
	fuerzaResultanteTiro := fuerzaFinalDelDelantero.!

