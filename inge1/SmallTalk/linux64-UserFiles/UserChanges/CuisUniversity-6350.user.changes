arbitroPitaConPelota: unPelota delanteroRemataAlArcoConDireccion: ubicacionTiroDelantero arqueroSeLanzaEnDirección: ubicacionLanzaArquero.

	pelota := unPelota .
	
	(ubicacionTiroDelantero between: 0@0 and: 2@2) ifFalse: [^self error: Penales direccionTiroFueraDeRango ].
	
	(ubicacionLanzaArquero between: 0@0 and: 2@2) ifFalse: [^self error: Penales direccionArqueroFueraDeRango ].
	
	delantero tipo = #AColocar 
		ifTrue: [fuerzaDelantero := delantero fuerza * 0.5.
			pelota tipo = #Playera 
				ifTrue: [fuerzaDelantero := fuerzaDelantero * 0.80.
					arquero tipo = #SeAdelanta
						ifTrue: [
							self gol:ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero .
						].
					arquero tipo = #DecideAntes
						ifTrue: [
							fuerzaArquero := arquero fuerza * 2.0.
							ubicacionTiroDelantero = ubicacionLanzaArquero 
								ifTrue: [fuerzaDelantero > fuerzaArquero 
									ifTrue: [self gol: ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero ] 
									ifFalse: [self noGol: ubicacionLanzaArquero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero ].
								] ifFalse: [
									self gol: ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero
								]
						].
				]. 
			pelota tipo = #Jabulani 
				ifTrue: [ fuerzaDelantero := fuerzaDelantero .
					arquero tipo = #SeAdelanta
						ifTrue: [ fuerzaArquero := arquero fuerza.
							ubicacionTiroDelantero x = ubicacionLanzaArquero x
								ifTrue: [fuerzaDelantero > fuerzaArquero 
									ifTrue: [self gol: ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero] 
									ifFalse: [self noGol: ubicacionLanzaArquero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero ].
								] ifFalse: [
									self gol: ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero
								]
						].
					arquero tipo = #DecideAntes	
						ifTrue: [
							fuerzaArquero := arquero fuerza *1.50.
							ubicacionTiroDelantero = ubicacionLanzaArquero 
								ifTrue: [fuerzaDelantero > fuerzaArquero 
									ifTrue: [self gol: ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero ] 
									ifFalse: [self noGol: ubicacionLanzaArquero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero].
								] ifFalse: [
									self gol: ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero 
								]
						].
				].	
		] .
	delantero tipo = #AMatar
		ifTrue: [fuerzaDelantero := delantero fuerza.
			pelota tipo = #Playera 
				ifTrue: [fuerzaDelantero := fuerzaDelantero.
					arquero tipo = #SeAdelanta
						ifTrue: [
							self gol:ubicacionTiroDelantero fuerzaResultanteArquero: fuerzaArquero fuerzaResultanteDelantero: fuerzaDelantero.
						].
					arquero tipo = #DecideAntes
						ifTrue: [
							fuerzaArquero := arquero fuerza * 2.0.
						].
				]. 
			pelota tipo = #Jabulani 
				ifTrue: [ fuerzaDelantero := fuerzaDelantero * 1.20.
					arquero tipo = #SeAdelanta
						ifTrue: [
							"accion" .
						].
					arquero tipo = #DecideAntes	
						ifTrue: [
							fuerzaArquero := arquero fuerza * 2.
						].
				].	
		] .! !

