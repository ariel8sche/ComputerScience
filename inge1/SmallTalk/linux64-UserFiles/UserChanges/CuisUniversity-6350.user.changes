									direccionResultante := ubicacionDeLaAtajada.
								] ifFalse: [
									direccionResultante := ubicacionDelTiro
								].
						].
				].	
		] .
	(delantero esDeTipo: #AMatar)
		ifTrue: [fuerzaDelantero := delantero fuerza.
			(pelota esDeTipo: #Playera)  
				ifTrue: [fuerzaDelantero := fuerzaDelantero.
					(arquero esDeTipo: #SeAdelanta)
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionDelTiro x ~= 1
								ifTrue: [
									ubicacionDelTiro y ~= 1
										ifTrue: [
											direccionResultante := (ubicacionDelTiro x @1).
										] ifFalse: [
											direccionResultante := ubicacionDelTiro. 			
										].
										atajaIgual := true.
								] ifFalse: [
									direccionResultante := ubicacionDelTiro. 
									atajaIgual := true.
								].
						].
					(arquero esDeTipo: #DecideAntes)
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionDelTiro x ~= 1
								ifTrue: [
									ubicacionDelTiro y ~= 1
										ifTrue: [
