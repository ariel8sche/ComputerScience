	| atajaIgual coordenadasIgualadas |
	
	coordenadasIgualadas := false.
	atajaIgual := false.
	puntajeDelantero := 0.
	puntajeArquero := 0.
	pelota := unaPelota.
	
	self disparoValido: ubicacionDelTiro.
	
	self atajadaValida: ubicacionDeLaAtajada.
	
	(delantero esDeTipo: #AColocar) 
		ifTrue: [
			fuerzaDelantero := delantero fuerza * delantero multiplicadorAColocar .
			(pelota esDeTipo: #Playera) 
				ifTrue: [
					fuerzaDelantero := fuerzaDelantero * delantero multiplicadorPelotaPlayera .
					"Como el arquero se adelanta, el arbitro lo ve, es gol y punto para el delantero "
					(arquero esDeTipo: #SeAdelanta)
						ifTrue: [
							fuerzaArquero := arquero fuerza * arquero multiplicadorEsperaYSeAdelantaConPlayera .
							direccionResultante := ubicacionDelTiro.
							fuerzaResultanteAtajada := fuerzaArquero.
							fuerzaResultanteTiro := fuerzaDelantero.
						].
					(arquero esDeTipo: #DecideAntes)
						ifTrue: [
							fuerzaArquero := arquero fuerza * arquero multiplicadorDecideAntesConPlayera.
							ubicacionDelTiro = ubicacionDeLaAtajada 
								ifTrue: [
									coordenadasIgualadas := true.
									direccionResultante := ubicacionDeLaAtajada.
								] ifFalse: [
									direccionResultante := ubicacionDelTiro.
								]. 
								fuerzaResultanteAtajada := fuerzaArquero.
								fuerzaResultanteTiro := fuerzaDelantero.
						].
				]. 
			(pelota esDeTipo: #Jabulani) 
				ifTrue: [ 
					fuerzaDelantero := fuerzaDelantero .
					(arquero esDeTipo: #SeAdelanta)
						ifTrue: [ 
							fuerzaArquero := arquero fuerza * arquero multiplicadorEsperaYSeAdelantaConJabulani .
							ubicacionDelTiro x = ubicacionDeLaAtajada x
								ifTrue: [
									coordenadasIgualadas := true.
									direccionResultante := ubicacionDelTiro
									
								] ifFalse: [
									direccionResultante := ubicacionDelTiro 
								].
								fuerzaResultanteAtajada := fuerzaArquero.
								fuerzaResultanteTiro := fuerzaDelantero.
						].
					(arquero esDeTipo: #DecideAntes)
						ifTrue: [
							fuerzaArquero := arquero fuerza * arquero multiplicadorDecideAntesConJabulani .
							ubicacionDelTiro = ubicacionDeLaAtajada 
								ifTrue: [
									coordenadasIgualadas := true.
									direccionResultante := ubicacionDeLaAtajada.
								] ifFalse: [
									direccionResultante := ubicacionDelTiro
								].
								fuerzaResultanteAtajada := fuerzaArquero.
								fuerzaResultanteTiro := fuerzaDelantero.
						].
				].	
		] .
	(delantero esDeTipo: #AMatar)
		ifTrue: [fuerzaDelantero := delantero fuerza.
			(pelota esDeTipo: #Playera)  
				ifTrue: [fuerzaDelantero := fuerzaDelantero.
					(arquero esDeTipo: #SeAdelanta)
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionDelTiro x ~= 1
								ifTrue: [
									ubicacionDelTiro y ~= 1
										ifTrue: [
											direccionResultante := (ubicacionDelTiro x @1).
											fuerzaResultanteAtajada := fuerzaArquero .
											fuerzaResultanteTiro = fuerzaDelantero.
											atajaIgual := true.
										] ifFalse: [
											direccionResultante := ubicacionDelTiro. 
											fuerzaResultanteAtajada := fuerzaArquero .
											fuerzaResultanteTiro = fuerzaDelantero.
											atajaIgual := true.
										].
								] ifFalse: [
											direccionResultante := ubicacionDelTiro. 
											fuerzaResultanteAtajada := fuerzaArquero .
											fuerzaResultanteTiro = fuerzaDelantero.
											atajaIgual := true.
								].
						].
					(arquero esDeTipo: #DecideAntes)
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionDelTiro x ~= 1
								ifTrue: [
									ubicacionDelTiro y ~= 1
										ifTrue: [
											1 = ubicacionDeLaAtajada y
												ifTrue: [
													fuerzaDelantero > fuerzaArquero 
														ifTrue: [
															self esGol: (ubicacionDelTiro x @1) 
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														] ifFalse: [
															self noEsGol: ubicacionDelTiro x@1
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														].
												] ifFalse: [
													self esGol: (ubicacionDelTiro x @1) 
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												]
										] ifFalse: [
											self noEsGol: (ubicacionDelTiro x @3) 
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										].
								] ifFalse: [
									ubicacionDelTiro y = 0 
										ifTrue: [
											2 = ubicacionDeLaAtajada y
												ifTrue: [
													fuerzaDelantero > fuerzaArquero 
														ifTrue: [
															self esGol: 1@2  
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														] ifFalse: [
															self noEsGol: 1@2 
															fuerzaResultanteArquero: fuerzaArquero 
															fuerzaResultanteDelantero: fuerzaDelantero
														].
												] ifFalse: [
													self esGol: 1@2
													fuerzaResultanteArquero: fuerzaArquero 
													fuerzaResultanteDelantero: fuerzaDelantero
												]
										] ifFalse: [
											self noEsGol: 1@ (ubicacionDelTiro y + 2)
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero 
										].
								].
						].
				]. 
			(pelota esDeTipo: #Jabulani) 
				ifTrue: [ fuerzaDelantero := fuerzaDelantero * 1.20.
					(arquero esDeTipo: #SeAdelanta)
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionDelTiro x ~= 1
								ifTrue: [
									ubicacionDelTiro y ~= 1
										ifTrue: [
											self esGol: (ubicacionDelTiro x @1) 
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										] ifFalse: [
											self esGol: ubicacionDelTiro  
											fuerzaResultanteArquero: fuerzaArquero 
											fuerzaResultanteDelantero: fuerzaDelantero
										].
								] ifFalse: [
									direccionResultante := ubicacionDelTiro.
									fuerzaResultanteAtajada := fuerzaArquero.
									fuerzaResultanteTiro := fuerzaDelantero
								].
						].
					(arquero esDeTipo: #DecideAntes)
						ifTrue: [
							fuerzaArquero := arquero fuerza .
							ubicacionDelTiro x ~= 1
								ifTrue: [
									ubicacionDelTiro y ~= 1
										ifTrue: [
											ubicacionDelTiro x = ubicacionDeLaAtajada x
												ifTrue: [
													fuerzaDelantero > fuerzaArquero 
														ifTrue: [
															coordenadasIgualadas := true.
															direccionResultante := (ubicacionDelTiro x @1).
															fuerzaResultanteAtajada := fuerzaArquero.
															fuerzaResultanteTiro := fuerzaDelantero .
														] ifFalse: [
															direccionResultante := (ubicacionDelTiro x @1).
															fuerzaResultanteAtajada := fuerzaArquero.
															fuerzaResultanteTiro := fuerzaDelantero .
														].
												] ifFalse: [
													direccionResultante := (ubicacionDelTiro x @1). 
													fuerzaResultanteAtajada := fuerzaArquero.
													fuerzaResultanteTiro := fuerzaDelantero.
												]
										] ifFalse: [
											ubicacionDelTiro x = ubicacionDeLaAtajada x
												ifTrue: [
													coordenadasIgualadas := true.
													direccionResultante := ubicacionDeLaAtajada.
													fuerzaResultanteAtajada := fuerzaArquero.
													fuerzaResultanteTiro := fuerzaDelantero
												] ifFalse: [
													direccionResultante :=ubicacionDelTiro.
													fuerzaResultanteAtajada := fuerzaArquero. 
													fuerzaResultanteTiro := fuerzaDelantero.
												]
										].
								] ifFalse: [
									ubicacionDelTiro = ubicacionDeLaAtajada 
										ifTrue: [
											coordenadasIgualadas := true.
											direccionResultante := ubicacionDeLaAtajada.
											fuerzaResultanteAtajada := fuerzaArquero.
											fuerzaResultanteTiro := fuerzaDelantero
										] ifFalse: [
											direccionResultante := ubicacionDelTiro.
											fuerzaResultanteAtajada := fuerzaArquero.
											fuerzaResultanteTiro := fuerzaDelantero
										]
								].
						].
				].	
		] .
	
	(direccionResultante between: 0@0 and: 2@2) 
		ifFalse: [puntajeArquero := 1]
		ifTrue: [ 
			((coordenadasIgualadas and: fuerzaResultanteTiro <= fuerzaResultanteAtajada) or: atajaIgual)
				ifTrue: [puntajeArquero := 1] 
				ifFalse: [puntajeDelantero := 1]
		].! !

