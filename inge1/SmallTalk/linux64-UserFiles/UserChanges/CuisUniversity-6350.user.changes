!CustomerBook methodsFor: 'customer management' stamp: 'as 4/6/2025 21:55:48' prior: 50545899!
suspendCustomerNamed: aName 
	
	(active includes: aName) ifFalse: [^CantSuspend signal].
	
	active remove: aName.
	
	suspended add: aName
! !

