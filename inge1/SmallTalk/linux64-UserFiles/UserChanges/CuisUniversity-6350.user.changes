gol: ubicacionTiroGol fuerzaResultanteArquero: fuerzaFinalArquero 

	puntajeDelantero := puntajeDelantero + 1. 
	direccionResultante := ubicacionTiroGol.
	fuerzaResultanteAtajada := pelota calcularFuerzaArquero: (arquero fuerza).
	fuerzaResultanteTiro := pelota calcularFuerzaDelantero: (delantero fuerza).! !
