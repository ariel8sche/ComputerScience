III class
	instanceVariableNames: 'previousNumber nextNumber'!

!classDefinition: 'III class' category: #Ejercicio4 stamp: 'as 3/23/2025 20:23:47'!
III class
	instanceVariableNames: 'previousNumber nextNumber'!
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 20:23:47'!
+ arg1
	^ previousNumber + arg1 next.! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 20:23:47'!
- sustrahend

	sustrahend name isEqualTo: I name ifTrue: [self previous] ifFalse: [self next - sustrahend previous]! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 20:23:47'!
next
	nextNumber isNil ifTrue: [ nextNumber := self cloneNamed: self name , 'I' ].
	nextNumber setPrevious: self.
	^ nextNumber.! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 20:23:47'!
previous
	^ previousNumber.! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 20:23:47'!
setPrevious: arg1
	previousNumber := arg1.! !

