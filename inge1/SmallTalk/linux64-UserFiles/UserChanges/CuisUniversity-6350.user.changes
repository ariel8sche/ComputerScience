!CashierTest methodsFor: 'receiving from empty trailer' stamp: 'as 4/15/2025 16:08:27' prior: 50558424!
test01ShouldNotAcceptEmptyTrailerFromNormalWorkingRobot

	| aRobot aTrailer aCashier |
	
	aTrailer := Trailer with: 20 and: 100.
	aRobot := Robot with: aTrailer.
	
	aCashier := Cashier new.

	self
		should: [ 
			aRobot closeOrderUsing: aCashier
		]
		raise: Error
		withMessageText: Cashier trailerIsEmptyErrorDescription.
! !
!CashierTest methodsFor: 'receiving from empty trailer' stamp: 'as 4/15/2025 16:08:43' prior: 50558437!
test02ShouldNotAcceptEmptyTrailerFromMechanicalFailureRobot

	| aRobot aTrailer aCashier |
	
	aTrailer := Trailer with: 20 and: 100.
	aRobot := Robot with: aTrailer.
	
	aCashier := Cashier new.

	self
		should: [ 
			aRobot withMechanicalFailure.
			aRobot closeOrderUsing: aCashier
		]
		raise: Error
		withMessageText: Cashier trailerIsEmptyErrorDescription.
! !
!CashierTest methodsFor: 'receiving from sensors failure robot' stamp: 'as 4/15/2025 16:08:57' prior: 50558452!
test03ShouldNotAcceptSensorsFailureRobot

	| aRobot aTrailer aCashier |
	
	aTrailer := Trailer with: 20 and: 100.
	aRobot := Robot with: aTrailer.
	
	aCashier := Cashier new.

	self
		should: [ 
			aRobot withSensorsFailure.
			aRobot closeOrderUsing: aCashier
 ]
		raise: Error
		withMessageText: Cashier robotSensorsFailureErrorDescription.
! !
!CashierTest methodsFor: 'receiving from sensors failure robot' stamp: 'as 4/15/2025 16:09:00' prior: 50559479!
test03ShouldNotAcceptSensorsFailureRobot

	| aRobot aTrailer aCashier |
	
	aTrailer := Trailer with: 20 and: 100.
	aRobot := Robot with: aTrailer.
	
	aCashier := Cashier new.

	self
		should: [ 
			aRobot withSensorsFailure.
			aRobot closeOrderUsing: aCashier]
		raise: Error
		withMessageText: Cashier robotSensorsFailureErrorDescription.
! !
!CashierTest methodsFor: 'receiving from mechanical failure robot' stamp: 'as 4/15/2025 16:09:34' prior: 50558466!
test04ShouldChangeRobotStatusToOutOfOrderWhenMechanicalFailureRobot

	| aRobot aTrailer aCashier |
	
	aTrailer := Trailer with: 20 and: 100.
	aRobot := Robot with: aTrailer.
	
	aCashier := Cashier new.

	self
		should: [ 
			aRobot take: (ProductA with: 1  and: 1).
			aRobot withMechanicalFailure.
			
			aRobot closeOrderUsing: aCashier.
			
			aRobot take: (ProductA with: 1 and: 1) ]
		raise: Error
		withMessageText: Robot outOfOrderErrorDescription.

! !

