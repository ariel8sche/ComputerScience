                           isViolatedBy: aMethodCategoryNode 
	^aMethodCategoryNode name size <= 1! !
!TestMethodCategoryNameRule class methodsFor: 'message' stamp: 'FL 9/22/2022 22:15:48' overrides: 50529778!
         description
	^'Method category has a meaningless name.
	
The method category name is useful to describe what set of methods contains.'! !
!TestMethodCategoryNameRule class methodsFor: 'message' stamp: 'FL 9/22/2022 22:13:01' overrides: 50529620!
          title
	^'Test-MethodCategory Name'! !
