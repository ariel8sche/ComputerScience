!ExtractToMethodObjectForm methodsFor: 'initialization' stamp: 'FGJ 4/11/2019 16:53:08'!
                  initializeWithModel: aModel

	super model: aModel.

	self setLabel: 'Extract Method to Method Object'.

	discardEdits := false.
