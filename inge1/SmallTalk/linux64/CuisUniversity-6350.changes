!CodeCoverageResultItem methodsFor: 'system primitives' stamp: 'NPM 11/2/2022 00:11:22'!
           allButFirst: numberOfCharacters

	^ self class
		for: item
		report: report
		skippingAllButFirst: numberOfCharacters ! !
