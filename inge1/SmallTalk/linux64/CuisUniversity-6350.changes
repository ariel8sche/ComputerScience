!AnalysisResult methodsFor: 'errors' stamp: 'MGD 10/3/2019 19:15:08'!
     isCorrect: aChange
	| stateAfterChange |
	
	stateAfterChange := self timeline stateAfter: aChange.
	
	^ stateAfterChange isCorrect and: [ (self hasError: aChange) not ]! !
