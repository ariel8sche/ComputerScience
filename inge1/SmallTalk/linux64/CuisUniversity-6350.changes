               create
	
	^ self new! !
!ClassNamesCatalog methodsFor: 'accessing' stamp: 'NPM 3/28/2020 02:39:01' overrides: 50403586!
        name
	
	^ 'Classes'! !
!ClassNamesCatalog methodsFor: 'searching' stamp: 'NPM 4/2/2020 02:30:48' overrides: 50403594!
          processNonEmptySearchQuery: aQuery

	^ SubstringMatcher
		valueFiltering: Smalltalk classNames
		with: aQuery! !
!ClassNamesCatalog methodsFor: 'browsing' stamp: 'NPM 4/2/2020 02:25:34' overrides: 50403610!
                 browse: aClassName 
	
	| class |
	class := (Smalltalk classNamed: aClassName).
	
	BrowserWindow
		fullOnClass: class! !
!CompositeCatalog methodsFor: 'accessing' stamp: 'NPM 4/1/2020 00:31:00' overrides: 50403586!
          name
	
	^ 'All'! !
!CompositeCatalog methodsFor: 'initialization' stamp: 'NPM 4/1/2020 00:30:46'!
                              initializeWithAll: children

	catalogs := children! !
!CompositeCatalog methodsFor: 'browsing' stamp: 'NPM 4/20/2020 16:31:26' overrides: 50403610!
            browse: aResult

	aResult browse
	! !
!CompositeCatalog methodsFor: 'searching' stamp: 'NPM 4/20/2020 16:47:20' overrides: 50403594!
                           processNonEmptySearchQuery: aQuery
	
	^ catalogs
		inject: OrderedCollection new
