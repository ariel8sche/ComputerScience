!ClassOrganizer class methodsFor: 'class variables' stamp: 'jmv 3/26/2024 12:09:39'!
          defaultMethodCategory
	^ Default! !
!SystemOrganizer class methodsFor: 'class variables' stamp: 'jmv 3/26/2024 12:15:06'!
