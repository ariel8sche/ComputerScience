                             newWithDefaults

	^self withThreshold: 20! !
!LongTestRule class methodsFor: 'instance creation' stamp: 'FL 5/29/2022 15:22:03'!
                               withThreshold: aThreshold 

	self validThreshold: aThreshold.
	
	^self new initializeWithThreshold: aThreshold ! !
