	anything."
	s signal.
	p terminate.
	self assert: (s instVarNamed: #excessSignals) equals: 1.! !
!SemaphoreTest methodsFor: 'testing' stamp: 'jmv 7/31/2023 11:58:41'!
                            testSemaAfterCriticalWaitInEnsure2
