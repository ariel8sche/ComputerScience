!Array methodsFor: 'printing' stamp: 'chaider 3/3/2024 11:51:39' prior: 16782812 overrides: 16783353!
                             storeOn: aStream 
	"Use the literal form if possible."

	self isLiteral
		ifTrue: [
			aStream nextPut: $#; nextPut: $(.
			self
				do: [ :element | 
					element storeOn: aStream ]
				separatedBy: [.
					aStream space ].
			aStream nextPut: $)]
		ifFalse: [super storeOn: aStream]! !

