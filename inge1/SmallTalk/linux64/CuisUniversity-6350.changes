	(self class methodDict includesKey: self initializeCollaboratorsFromFileMessageName) ifTrue: [
		aStream 
			newLine;
		 	nextChunkPut: self name , ' ', self initializeAfterFileInMessageName asString.
			
		self removeInitializeCollaboratorsFromFile ].! !
