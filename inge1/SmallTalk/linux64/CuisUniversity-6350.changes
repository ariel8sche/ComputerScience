	! !
!SimpleMeasure methodsFor: 'magnitude protocol - private' stamp: 'HAW 3/25/2017 19:53:38' overrides: 50382587!
                            greaterThanSimpleMeasure: aMeasure 
	"If the unit is the same one, verifies only the amount.
	aMeasure converts to baseUnit so that if there is some error of conversion this jumps fast and generates
	CanNotConvertMeasureException correctly."
	
	^unit = aMeasure unit 
		ifTrue: [aMeasure amount < amount]
		ifFalse: 
			[(aMeasure convertTo: self baseUnit) amount 
				< self convertAmountToBaseUnit]! !
!SimpleMeasure methodsFor: 'magnitude protocol - private' stamp: 'HAW 3/25/2017 19:55:04' overrides: 50382593!
                             lessThanSimpleMeasure: aMeasure 
	"If the unit is the same one, verifies only the amount.
	aMeasure converts to baseUnit so that if there is some error of conversion this jumps fast and generates
	CanNotConvertMeasureException correctly."

	^unit = aMeasure unit 
		ifTrue: [aMeasure amount > amount]
		ifFalse: 
			[(aMeasure convertTo: self baseUnit) amount 
				> self convertAmountToBaseUnit]! !
!SimpleMeasure methodsFor: 'bag creation - private' stamp: 'HAW 3/25/2017 20:02:38' overrides: 50382598!
       composeWith: aMeasure

	^self isNothing
		ifTrue: [aMeasure]
		ifFalse: [aMeasure composeWithSimpleMeasure: self]! !
!SimpleMeasure methodsFor: 'bag creation - private' stamp: 'HAW 3/25/2017 20:03:37' overrides: 50382603!
  composeWithNumber: aNumber

	^self isNothing
		ifTrue: [aNumber]
		ifFalse: [CompoundMeasure measures: (OrderedCollection with: self with: aNumber)]! !
!SimpleMeasure methodsFor: 'bag creation - private' stamp: 'HAW 3/25/2017 20:01:57' overrides: 50382608!
                               composeWithSimpleMeasure: aMeasure

	^self isNothing
		ifTrue: [aMeasure]
		ifFalse: 
			[CompoundMeasure measures: (OrderedCollection with: self with: aMeasure)]! !
