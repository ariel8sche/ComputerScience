	self verify: (100 arcTan: -100) isTrigonometricallyEqualTo: Float pi * 3 / 4.
	self verify: (-100 arcTan: -100) isTrigonometricallyEqualTo: Float pi * -3 / 4.
	self verify: (0 arcTan: 100) isTrigonometricallyEqualTo: 0.
	self verify: (0 arcTan: -100) isTrigonometricallyEqualTo: Float pi.
