	withPossibleMessageSends: aShouldChangePossibleMessageSends

	^self 
		assertAndCreateNamed: aNewParameter 
		extractedFromAll: intervals
		at: aSourceMethod  
		implementors: implementorsCollection 
		senders: sendersCollection
