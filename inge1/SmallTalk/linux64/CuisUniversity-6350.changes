                  rootClasses
	"
	Answer class hierarchy roots. This is, classes without superclass.
	Smalltalk rootClasses
	"
	^Array streamContents: [ :strm |
		self do: [ :root |
			(root isBehavior and: [root superclass isNil]) ifTrue: [	"Grab ProtoObject and any other alike"
				strm nextPut: root ]]]! !

