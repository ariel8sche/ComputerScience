!DefinedByRulesTest methodsFor: 'test includes' stamp: 'HAW 3/27/2017 10:05:32'!
                   testIncludedFromTo

	| set |
	
	set := DefinedByRules for: NaturalNumbersTestUniverse new.
	set 
		addRule: (SpecificObjectInclusionRule for: 1);
