!IntroduceNullObjectForm class methodsFor: 'instance creation' stamp: 'FGJ 4/5/2019 16:13:58' overrides: 16971793!
                              open: aModel label: aString

	|  window |

	window _ self withModel: aModel.
	window buildMorphicWindow.
	aString ifNotNil: [ window setLabel: aString ].
	window openInWorld.
	^window! !
