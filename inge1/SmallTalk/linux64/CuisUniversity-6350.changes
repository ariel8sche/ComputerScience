	self assert: 1e400 = 1.0e309.
	self assert: 1e400 > 1.0e308.


	self assert: -1e400 = Float negativeInfinity.
	self deny: -1e400 < Float negativeInfinity.
	self deny: -1e400 > Float negativeInfinity.

	self assert: -1e400 = -1.0e309.
	self assert: -1e400 < -1.0e308.! !
