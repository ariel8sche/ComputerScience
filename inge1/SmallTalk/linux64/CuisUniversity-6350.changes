            assertMethodNamed: aMethodName in: aClass hasSourceEqualTo: aSourceCode

	| changedMethodNode |

	changedMethodNode _ self methodNodeIn: aClass named: aMethodName.
	self assert: aSourceCode equals: changedMethodNode sourceText.
			! !
