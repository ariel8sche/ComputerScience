                             testDoesNotPrintAsteriskWhenUnitNumeratorIsNullUnit

	self assert: '1' equals: (SimpleMeasure amount: 1 unit: NullUnit new) printString.
	self assert: '10/meters' equals: (10 / self meter) printString.
	
	! !
