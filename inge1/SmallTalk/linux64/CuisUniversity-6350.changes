!DecompilerTestFailuresCollector methodsFor: 'accessing' stamp: 'HAW 3/17/2019 07:26:22' overrides: 16975293!
                          assert: aBoolean description: aString resumable: resumableBoolean 
	
	aBoolean ifFalse: [
