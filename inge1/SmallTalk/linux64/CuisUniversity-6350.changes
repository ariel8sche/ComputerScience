III class
	instanceVariableNames: 'previousNumber nextNumber'!

!classDefinition: 'III class' category: #Ejercicio4 stamp: 'as 3/23/2025 23:09:35'!
III class
	instanceVariableNames: 'previousNumber nextNumber'!
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
             * aMultiplicandt

	^ aMultiplicandt  + (self previous  * aMultiplicandt ).! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
               + arg1
	^ previousNumber + arg1 next.! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
                    - sustrahend

	sustrahend name = I name ifTrue: [^ self previous].
	^ (self previous - sustrahend previous).! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
             / dividend

	self = dividend ifTrue: [^I].
	^ I + ((self - dividend )/ dividend ).! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
       next
	nextNumber isNil ifTrue: [ nextNumber := self cloneNamed: self name , 'I' ].
	nextNumber setPrevious: self.
	^ nextNumber.! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
                         previous
	^ previousNumber.! !
!III class methodsFor: '-- all --' stamp: 'as 3/23/2025 23:09:35'!
                              setPrevious: arg1
	previousNumber := arg1.! !

