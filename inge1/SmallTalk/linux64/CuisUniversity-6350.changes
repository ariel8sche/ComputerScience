                               variableNameToTypeIndex

	^variableNameToTypeIndex! !
!AdditionalMethodState methodsFor: '*LiveTyping' stamp: 'HAW 2/28/2019 17:06:53'!
                        variablesNames

	| names |
	
	names := OrderedCollection new.
	self variablesNamesDo: [ :aVarName | names add: aVarName ].
	
