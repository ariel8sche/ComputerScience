                          testHash

	| month |
	
	month := NonSpecificThirtyOneDaysGregorianMonth named: 'xxx' number: 1.
	self assert: month hash = month hash! !
!NonSpecificThirtyOneDaysGregorianMonthTest methodsFor: 'test accessing'!
             testLastDayNumber

	| month |
	
	month := NonSpecificThirtyOneDaysGregorianMonth named: 'xxx' number: 1.
