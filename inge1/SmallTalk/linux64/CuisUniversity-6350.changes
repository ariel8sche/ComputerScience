	FileIOAccessor default drives
	"
	drives := nil. 		"will change if you mount or unmount drives!!"
	drives ifNil: [
		drives := self onWindows
			ifTrue: [ (self entriesIn: nil)]
			ifFalse: [ #() ]].
	^drives! !
